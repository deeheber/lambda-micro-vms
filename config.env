# Every tunable for the scripts lives here. Plain KEY=value so bash and sh can
# both source it. Template tunables are CloudFormation Parameters in infra/.
# Secrets and the account ID never go here: see EXPECTED_ACCOUNT_ID in .env.

# AWS region for every call. lib.sh exports it as AWS_REGION unless already set.
# This is the only file in the repo that names a region. Source: user choice.
REGION=us-west-2
# Prefix for the two CloudFormation stack names (<prefix>-bootstrap, <prefix>-image).
STACK_PREFIX=mvm-hello
# Name of the MicroVM image resource. Source: user choice.
IMAGE_NAME=mvm-hello
# Image description; CloudFormation requires one.
IMAGE_DESCRIPTION="Lambda MicroVMs hello world"
# Port the app server listens on. Source: the MicroVM proxy's default target port.
APP_PORT=8080
# Port the lifecycle hooks server listens on. Source: documented hooks default.
HOOKS_PORT=9000
# Memory baseline in MiB (compute scales with it). Source: documented default, 2 GB and 1 vCPU.
MEMORY_MIB=2048
# How long the image build waits for the ready hook. Source: documented default.
READY_TIMEOUT_SECONDS=30
# How long the run hook may take. Source: headroom over the documented 1 s default.
RUN_TIMEOUT_SECONDS=5
# Idle time before the MicroVM suspends (minimum 60). Source: sandbox cost choice.
IDLE_MAX_SECONDS=300
# How long a suspended MicroVM is kept before it is terminated. Source: sandbox cost choice.
SUSPENDED_SECONDS=600
# Whether a request to a suspended MicroVM resumes it automatically. Source: user choice.
AUTO_RESUME=true
# Hard cap on a MicroVM's lifetime (max 28800). Source: sandbox cost choice.
MAX_DURATION_SECONDS=1800
# Lifetime of the auth token minted by call.sh (max 60). Source: user choice.
TOKEN_TTL_MINUTES=15
# CloudWatch log retention in days. Source: user choice.
LOG_RETENTION_DAYS=7
# How long smoke.sh waits for auto-resume before it calls resume explicitly.
RESUME_WAIT_SECONDS=30
# How long smoke.sh retries the first call after run.sh.
CALL_READY_TIMEOUT_SECONDS=60
# curl --max-time in call.sh; long enough that a request held during auto-resume survives.
CURL_MAX_TIME_SECONDS=60
# Managed base image version. Empty means latest: deploy.sh picks the newest
# buildable version. A non-empty value pins that version.
BASE_IMAGE_VERSION=

# Seconds between polls in the scripts. Source: plan choice.
POLL_INTERVAL_SECONDS=5
# How long deploy.sh waits for the image build. Source: plan choice.
IMAGE_WAIT_SECONDS=1800
# How long scripts wait for a MicroVM to reach TERMINATED. Source: plan choice.
TERMINATE_WAIT_SECONDS=120
# Managed ingress connector for run.sh. Empty means no ingress flag; HTTP_INGRESS
# is the only other allowed value (see SPEC Open question 4).
INGRESS_CONNECTOR=
